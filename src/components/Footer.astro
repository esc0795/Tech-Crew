---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <!-- Columna 1: Branding -->
      <div class="footer-brand">
        <a
          href="/Tech-Crew/"
          class="footer-logo-link"
          aria-label="Tech Crew Inicio"
        >
          <img
            src="/Tech-Crew/tc.png"
            alt="Tech Crew Logo"
            class="footer-logo"
          />
        </a>
        <p class="footer-tagline">
          Impulsamos negocios y marcas con soluciones web modernas,
          automatizaci&oacute;n y tecnolog&iacute;a estrat&eacute;gica de alto
          impacto.
        </p>
        <div class="footer-location">
          <span class="location-dot"></span>
          <span>Alajuela, Costa Rica &#127464;&#127479;</span>
        </div>
      </div>

      <!-- Columna 2: Soluciones -->
      <div class="footer-col">
        <h4>Soluciones</h4>
        <ul class="footer-links">
          <li><a href="/Tech-Crew/#soluciones">Tiendas con WhatsApp</a></li>
          <li><a href="/Tech-Crew/#soluciones">Landing Pages &amp; SEO</a></li>
          <li>
            <a href="/Tech-Crew/#soluciones"
              >Men&uacute;s QR para Restaurantes</a
            >
          </li>
          <li><a href="/Tech-Crew/#soluciones">CVs Web Optimizados IA</a></li>
          <li>
            <a href="/Tech-Crew/#soluciones">Digitalizaci&oacute;n Integral</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto & Enlaces -->
      <div class="footer-col">
        <h4>Contacto Directo</h4>
        <ul class="footer-links footer-contact-info">
          <li>
            <a href="mailto:techcrewcr@gmail.com" class="contact-item">
              <svg
                class="footer-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>techcrewcr@gmail.com</span>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/?text=Hola%20Tech%20Crew,%20quiero%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20soluciones%20digitales"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-item"
            >
              <svg class="footer-icon" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.527 1.834.78 2.796.78 3.184 0 5.77-2.587 5.77-5.766.001-3.187-2.575-5.77-5.77-5.77zm0 10.457c-.854 0-1.636-.237-2.316-.649l-.166-.1-1.581.415.422-1.541-.109-.174c-.452-.721-.69-1.564-.69-2.428 0-2.493 2.029-4.521 4.523-4.521 2.494 0 4.524 2.028 4.525 4.521 0 2.495-2.03 4.524-4.524 4.524zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.438 5.18L2 22l4.975-1.305A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"
                ></path>
              </svg>
              <span>WhatsApp Oficial</span>
            </a>
          </li>
          <li>
            <a
              href="/Tech-Crew/#soluciones"
              class="contact-item footer-cta-link"
            >
              <svg
                class="footer-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Agendar llamada</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Redes Sociales -->
      <div class="footer-col">
        <h4>Con&eacute;ctate</h4>
        <p class="footer-social-text">
          S&iacute;guenos y descubre novedades, tips y proyectos.
        </p>
        <div class="footer-social-links">
          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn"
            aria-label="Instagram de Tech Crew"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn"
            aria-label="LinkedIn de Tech Crew"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
