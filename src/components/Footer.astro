              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/?text=Hola%20Tech%20Crew,%20quiero%20m%C3%A1s%20informaci%C3%B3n"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn whatsapp-social"
            aria-label="WhatsApp de Tech Crew"
          >
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.527 1.834.78 2.796.78 3.184 0 5.77-2.587 5.77-5.766.001-3.187-2.575-5.77-5.77-5.77zm0 10.457c-.854 0-1.636-.237-2.316-.649l-.166-.1-1.581.415.422-1.541-.109-.174c-.452-.721-.69-1.564-.69-2.428 0-2.493 2.029-4.521 4.523-4.521 2.494 0 4.524 2.028 4.525 4.521 0 2.495-2.03 4.524-4.524 4.524zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.438 5.18L2 22l4.975-1.305A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra inferior con derechos de autor y créditos -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear}
        <strong>Tech Crew</strong>. Todos los derechos reservados. Alajuela,
        Costa Rica.
      </p>
      <p class="credits">
        Soluciones y Estrategia Digital con Tecnolog&iacute;a de Alto
        Rendimiento.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    background: #050505;
    border-top: 1px solid rgba(241, 205, 0, 0.15);
    color: #e0e0e0;
    padding: 4.5rem 1.5rem 2rem 1.5rem;
    font-family: inherit;
    box-sizing: border-box;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Branding */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo-link {
    display: inline-block;
    margin-bottom: 1.2rem;
    transition: transform 0.3s ease;
  }

  .footer-logo-link:hover {
    transform: translateY(-2px);
  }

  .footer-logo {
    height: 50px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(241, 205, 0, 0.2));
  }

  .footer-tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #a0a0a0;
    margin: 0 0 1.2rem 0;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #dcdcdc;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(241, 205, 0, 0.2);
    padding: 0.35rem 0.8rem;
    border-radius: 20px;
  }

  .location-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f1cd00;
    box-shadow: 0 0 8px #f1cd00;
  }

  /* Columnas */
  .footer-col h4 {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 1.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-col h4::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 25px;
    height: 2px;
    background: #f1cd00;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links li a {
    color: #9e9e9e;
    text-decoration: none;
    font-size: 0.92rem;
    transition: all 0.25s ease;
    display: inline-block;
  }

  .footer-links li a:hover {
    color: #f1cd00;
    transform: translateX(4px);
  }

  /* Contacto */
  .footer-contact-info .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #b0b0b0;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.25s ease;
  }

  .footer-contact-info .contact-item:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  .footer-icon {
    width: 18px;
    height: 18px;
    color: #f1cd00;
    flex-shrink: 0;
  }

  .footer-cta-link {
    color: #f1cd00 !important;
    font-weight: 600;
  }

  /* Redes Sociales */
  .footer-social-text {
    font-size: 0.9rem;
    color: #9e9e9e;
    line-height: 1.5;
    margin: 0 0 1.2rem 0;
  }

  .footer-social-links {
    display: flex;
    gap: 0.8rem;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-icon-btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .social-icon-btn:hover {
    background: #f1cd00;
    color: #000;
    border-color: #f1cd00;
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(241, 205, 0, 0.35);
  }

  .social-icon-btn.whatsapp-social:hover {
    background: #25d366;
    border-color: #25d366;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.85rem;
    color: #7a7a7a;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright strong {
    color: #c0c0c0;
  }

  .credits {
    color: #888;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: 3.5rem 1.2rem 1.8rem 1.2rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      padding-bottom: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.6rem;
    }
  }
</style>
