  }

  .soluciones-badge {
    display: inline-block;
    background: rgba(241, 205, 0, 0.1);
    border: 1px solid rgba(241, 205, 0, 0.4);
    color: #f1cd00;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    margin-bottom: 1.2rem;
    backdrop-filter: blur(8px);
  }

  .soluciones-section h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem 0;
    color: #ffffff;
    line-height: 1.2;
  }

  .soluciones-subtitle {
    font-size: 1.15rem;
    color: #b0b0b0;
    line-height: 1.6;
    margin: 0;
  }

  .solution-cards {
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .solution-card {
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(241, 205, 0, 0.25);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
  }

  .solution-card:hover {
    border-color: rgba(241, 205, 0, 0.6);
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.7),
      0 0 20px rgba(241, 205, 0, 0.12);
  }

  .solution-card.open {
    border-color: #f1cd00;
    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.8),
      0 0 25px rgba(241, 205, 0, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.3rem 1.8rem;
    cursor: pointer;
    background: rgba(15, 15, 15, 0.9);
    transition: background 0.3s ease;
    user-select: none;
  }

  .card-header:hover {
    background: rgba(30, 26, 12, 0.95);
  }

  .header-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .solution-chip {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #f1cd00;
  }

  .solution-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.3px;
  }

  .icon {
    font-size: 1.8rem;
    font-weight: 300;
    color: #f1cd00;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .solution-card.open .icon {
    transform: rotate(45deg);
  }

  .card-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .solution-card.open .card-content {
    max-height: 500px;
  }

  .card-content-inner {
    padding: 1.5rem 1.8rem 1.8rem 1.8rem;
    border-top: 1px solid rgba(241, 205, 0, 0.15);
    background: rgba(5, 5, 5, 0.6);
  }

  .card-content-inner p {
    font-size: 1rem;
    color: #cccccc;
    margin: 0 0 1.2rem 0;
    line-height: 1.6;
  }

  .solution-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.2rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .solution-bullet {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: #e0e0e0;
    line-height: 1.5;
  }

  .solution-bullet strong {
    color: #f1cd00;
  }

  .bullet-check {
    color: #f1cd00;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* Overlay oscuro */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Caja del modal */
  .modal-content {
    box-sizing: border-box;
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(241, 205, 0, 0.3);
    color: #fff;
    padding: 2rem 1.8rem;
    border-radius: 14px;
    width: 90%;
    max-width: 420px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow:
      0 0 40px rgba(0, 0, 0, 0.9),
      inset 0 0 20px rgba(241, 205, 0, 0.05);
    animation: modalPop 0.35s ease;
  }

  .schedule-modal-content {
    max-width: 520px;
  }

  .schedule-modal-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .schedule-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: rgba(241, 205, 0, 0.12);
    border: 1.5px solid rgba(241, 205, 0, 0.4);
    border-radius: 50%;
    color: #f1cd00;
    margin-bottom: 0.8rem;
    box-shadow: 0 0 15px rgba(241, 205, 0, 0.2);
  }

  .modal-calendar-icon {
    width: 24px;
    height: 24px;
  }

  .schedule-modal-header h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 0.4rem 0;
    color: #ffffff;
  }

  .schedule-modal-subtitle {
    font-size: 0.92rem;
    color: #b0b0b0;
    margin: 0;
    line-height: 1.4;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 550px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* Success Card & Calendar Action Buttons */
  /* Loading Card */
  .schedule-loading-card {
    text-align: center;
    padding: 2.2rem 1rem 1.5rem 1rem;
    animation: modalPop 0.35s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .schedule-spinner {
    width: 52px;
    height: 52px;
    border: 3px solid rgba(241, 205, 0, 0.15);
    border-top: 3px solid #f1cd00;
    border-right: 3px solid #f1cd00;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
    margin-bottom: 1.4rem;
    box-shadow: 0 0 25px rgba(241, 205, 0, 0.35);
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .schedule-loading-card h3 {
    font-size: 1.35rem;
    color: #ffffff;
    margin: 0 0 0.6rem 0;
  }

  .schedule-loading-card p {
    font-size: 0.92rem;
    color: #a8a8a8;
    line-height: 1.5;
    margin: 0 0 1.2rem 0;
    max-width: 380px;
  }

  .loading-progress-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(241, 205, 0, 0.08);
    border: 1px solid rgba(241, 205, 0, 0.25);
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.84rem;
    color: #f1cd00;
  }

  .loading-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f1cd00;
    box-shadow: 0 0 8px #f1cd00;
    animation: pulse 1.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(0.85); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 1; }
  }

  /* Success Card & Calendar Action Buttons */
  .schedule-success-card {
    text-align: center;
    padding: 1.8rem 0.5rem 0.8rem 0.5rem;
    animation: modalPop 0.35s ease;
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    background: rgba(37, 211, 102, 0.15);
    border: 2px solid #25d366;
    border-radius: 50%;
    color: #25d366;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1.2rem;
    box-shadow: 0 0 25px rgba(37, 211, 102, 0.4);
    animation: pulse 2s infinite ease-in-out;
  }

  .schedule-success-card h3 {
    font-size: 1.45rem;
    color: #ffffff;
    margin: 0 0 0.6rem 0;
  }

  .schedule-success-card p {
    font-size: 0.95rem;
    color: #d0d0d0;
    line-height: 1.6;
    margin: 0 0 1.6rem 0;
  }

  .hidden {
    display: none !important;
  }

  .calendar-action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .wa-confirm-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #25d366;
    color: #000000;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.5px;
    padding: 1rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
    cursor: pointer;
  }

  .wa-confirm-btn:hover {
    background: #20ba59;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(37, 211, 102, 0.6);
  }

  .wa-icon {
    width: 22px;
    height: 22px;
  }

  @keyframes modalPop {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Botón cerrar */
  .modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Inputs */
  .modal-content input,
  .modal-content select,
  .modal-content textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem;
    margin-top: 0.3rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background-color: #121212 !important;
    color: #ffffff !important;
    color-scheme: dark !important;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .modal-content input:not([type="submit"]),
  .modal-content select {
    height: 45px;
  }

  .modal-content select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1em;
    padding-right: 2.5rem;
  }

  .modal-content select option {
    background-color: #f9fafb !important;
    color: #111827 !important;
  }

  .modal-content select option:hover,
  .modal-content select option:focus,
  .modal-content select option:active,
  .modal-content select option:checked {
    background-color: #e5e7eb !important;
    color: #000000 !important;
  }

  .modal-content select option:disabled {
    color: #9ca3af !important;
    background-color: #f9fafb !important;
  }

  .modal-content input:focus,
  .modal-content textarea:focus {
    outline: none;
    border-color: #f1cd00;
    background-color: rgba(255, 255, 255, 0.1) !important;
  }

  .modal-content select:focus,
  .modal-content select:active,
  .modal-content select[open],
  .modal-content select.is-open {
    outline: none;
    border-color: #f1cd00;
    background-color: #f9fafb !important;
    color: #111827 !important;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23111827' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
  }

  /* Botón enviar */
  .send-btn {
    background: #f5c400;
    color: #000;
    padding: 0.8rem 1.6rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
    transition: opacity 0.2s ease;
  }

  .send-btn:hover {
    opacity: 0.8;
    background-color: #fdf6f6;
  }

  /* Oculto */
  .hidden {
    display: none !important;
  }

  @media (max-width: 550px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

