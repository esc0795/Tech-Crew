<script>
  // ---------------------------
  // Canvas Tech Animation
  // ---------------------------
  const canvas = document.getElementById("global-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
    }

    let particles: Particle[] = [];

    function initCanvas() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      particles = [];
      const numParticles = Math.floor((width * height) / 12000) || 30;
      for (let i = 0; i < numParticles; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          radius: Math.random() * 1.5 + 0.5,
        });
      }
    }

    function drawParticles() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgba(241, 205, 0, 0.7)";
      ctx.lineWidth = 0.5;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist = Math.sqrt((p.x - p2.x) ** 2 + (p.y - p2.y) ** 2);
          if (dist < 120) {
            ctx.strokeStyle = `rgba(241, 205, 0, ${1 - dist / 120})`;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawParticles);
    }

    initCanvas();
    drawParticles();
    window.addEventListener("resize", initCanvas);
  }

  // ---------------------------
  // Toggle de tarjetas
  // ---------------------------
  function toggleCard(header: HTMLElement) {
    const card = header.closest(".solution-card");
    if (card) {
      card.classList.toggle("open");
    }
  }
  (window as unknown as { toggleCard: typeof toggleCard }).toggleCard = toggleCard;

  // ---------------------------
  // Modal de Contacto
  // ---------------------------
  const openContactBtn = document.querySelector<HTMLElement>("#open-modal-btn");
  const contactModal = document.querySelector<HTMLElement>("#contact-modal");
  const closeContactBtn = document.querySelector<HTMLElement>("#modal-close");
  const contactForm = document.querySelector<HTMLFormElement>("#modal-contact-form");
  const contactStatusEl = document.querySelector<HTMLElement>("#modal-status");

  if (openContactBtn && contactModal) {
    openContactBtn.addEventListener("click", (e) => {
      e.preventDefault();
      contactModal.classList.add("active");
    });
  }

  if (closeContactBtn && contactModal) {
    closeContactBtn.addEventListener("click", () => {
      contactModal.classList.remove("active");
    });
  }

  if (contactModal) {
    contactModal.addEventListener("click", (e) => {
      if (e.target === contactModal) contactModal.classList.remove("active");
    });
  }

  // ---------------------------
  // Modal de Agendar Llamada + Google Calendar
  // ---------------------------
  const scheduleHeader = document.querySelector<HTMLElement>("#schedule-modal-header");
  const scheduleBtn = document.querySelector<HTMLElement>("#schedule-call-btn");
  const scheduleModal = document.querySelector<HTMLElement>("#schedule-modal");
  const closeScheduleBtn = document.querySelector<HTMLElement>("#schedule-modal-close");
  const scheduleForm = document.querySelector<HTMLFormElement>("#schedule-call-form");
  const scheduleDateInput = document.querySelector<HTMLInputElement>("#schedule-date");
  const scheduleStatusEl = document.querySelector<HTMLElement>("#schedule-status");
  const scheduleSuccessCard = document.querySelector<HTMLElement>("#schedule-success-card");
  const scheduleSuccessDetails = document.querySelector<HTMLElement>(
    "#schedule-success-details",
  );
  const gcalBtn = document.querySelector<HTMLAnchorElement>("#gcal-add-btn");
  const waConfirmBtn = document.querySelector<HTMLAnchorElement>("#whatsapp-confirm-btn");

  // Establecer fecha mínima como hoy
  if (scheduleDateInput) {
    const today = new Date().toISOString().split("T")[0];
    scheduleDateInput.min = today;
    scheduleDateInput.value = today;
  }

  if (scheduleBtn && scheduleModal) {
    scheduleBtn.addEventListener("click", (e) => {
      e.preventDefault();
      scheduleModal.classList.add("active");
      if (scheduleHeader) scheduleHeader.classList.remove("hidden");
      if (scheduleForm) scheduleForm.classList.remove("hidden");
      if (scheduleSuccessCard) scheduleSuccessCard.classList.add("hidden");
      if (scheduleStatusEl) scheduleStatusEl.textContent = "";
    });
  }

  if (closeScheduleBtn && scheduleModal) {
    closeScheduleBtn.addEventListener("click", () => {
      scheduleModal.classList.remove("active");
    });
  }

  if (scheduleModal) {
    scheduleModal.addEventListener("click", (e) => {
      if (e.target === scheduleModal) scheduleModal.classList.remove("active");
    });
  }

  interface GCalParams {
    title: string;
    description: string;
    location: string;
    startDate: Date;
    durationMinutes?: number;
    attendees?: string[];
  }

  // Helper para generar URL de Google Calendar con invitados vinculados
  function generateGoogleCalendarUrl({
    title,
    description,
    location,
    startDate,
    durationMinutes = 30,
    attendees = [],
  }: GCalParams): string {
    const pad = (n: number) => String(n).padStart(2, "0");
    const formatUtc = (d: Date) => {
      return (
        d.getUTCFullYear() +
        pad(d.getUTCMonth() + 1) +
        pad(d.getUTCDate()) +
        "T" +
        pad(d.getUTCHours()) +
        pad(d.getUTCMinutes()) +
        pad(d.getUTCSeconds()) +
        "Z"
      );
    };

    const endDate = new Date(startDate.getTime() + durationMinutes * 60 * 1000);
    const startStr = formatUtc(startDate);
    const endStr = formatUtc(endDate);

    const params = new URLSearchParams({
      action: "TEMPLATE",
      text: title,
      details: description,
      location: location,
      dates: `${startStr}/${endStr}`,
    });

    // Agregar invitados (Cliente y Tech Crew) para vincular el evento a ambos correos
    if (attendees && attendees.length > 0) {
      params.append("add", attendees.join(","));
    }

    return `https://calendar.google.com/calendar/render?${params.toString()}`;
  }

  // ---------------------------
  // Google Sheets / Envío de Formularios
  // ---------------------------
  const CREW_EMAIL = "techcrewcr@gmail.com";
  const SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbz8YJmjhHiEXD-o3iYDErabiZ-vZITA7lXqTtAIUVHJL9hyDw4ATbqY7YX8FYEInsWW/exec";

  // Envío de Formulario de Contacto
  if (contactForm) {
    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (contactStatusEl) contactStatusEl.textContent = "Enviando...";

      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData.entries()) as Record<string, string>;

      try {
        await fetch(SCRIPT_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8",
          },
          body: JSON.stringify({
            ...data,
            tipo_formulario: "Contacto",
            correo_crew: CREW_EMAIL,
          }),
        });

        if (contactStatusEl)
          contactStatusEl.textContent =
            "¡Mensaje enviado! Pronto te contactaremos";
        contactForm.reset();

        setTimeout(() => {
          if (contactModal) contactModal.classList.remove("active");
          if (contactStatusEl) contactStatusEl.textContent = "";
        }, 1500);
      } catch (err) {
        console.error(err);
        if (contactStatusEl)
          contactStatusEl.textContent = "Error al enviar. Intenta de nuevo.";
      }
    });
  }

  // Envío de Formulario de Agendar Llamada
  if (scheduleForm) {
    scheduleForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (scheduleStatusEl)
        scheduleStatusEl.textContent = "Agendando tu sesión...";

      const formData = new FormData(scheduleForm);
      const data = Object.fromEntries(formData.entries()) as Record<string, string>;

      try {
        // Enviar datos y correos al backend de Google Apps Script
        fetch(SCRIPT_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8",
          },
          body: JSON.stringify({
            ...data,
            tipo_formulario: "Agendar Llamada",
            correo_crew: CREW_EMAIL,
            invitados: `${data.email}, ${CREW_EMAIL}`,
            evento_titulo: `Llamada de Consultoría - Tech Crew (${data.servicio_interes})`,
          }),
        }).catch((err) => console.warn("Registro en segundo plano:", err));

        // Calcular fecha y hora de la cita
        const [year, month, day] = (data.fecha || "").split("-").map(Number);
        const [hours, minutes] = (data.hora || "").split(":").map(Number);
        const startDateTime = new Date(year, month - 1, day, hours, minutes);

        const clientEmail = (data.email || "").trim();

        // Generar enlace de Google Calendar vinculado a ambos correos
        const gcalUrl = generateGoogleCalendarUrl({
          title: `Llamada de Consultoría - Tech Crew (${data.servicio_interes})`,
          description: `Llamada estratégica con Tech Crew.\n\nCliente: ${data.nombre}\nWhatsApp: ${data.telefono}\nCorreo: ${clientEmail}\nSolución de Interés: ${data.servicio_interes}\nOrganizador: Tech Crew (${CREW_EMAIL})`,
          location: "Google Meet",
          startDate: startDateTime,
          durationMinutes: 30,
          attendees: [CREW_EMAIL, clientEmail],
        });

        if (gcalBtn) gcalBtn.href = gcalUrl;

        // Generar enlace de confirmación por WhatsApp
        const waText = encodeURIComponent(
          `¡Hola Tech Crew! 👋 Acabo de agendar una llamada de consultoría para el día ${data.fecha} a las ${data.hora}.\n\nNombre: ${data.nombre}\nCorreo: ${clientEmail}\nInterés: ${data.servicio_interes}`,
        );
        if (waConfirmBtn) waConfirmBtn.href = `https://wa.me/?text=${waText}`;

        // Formatear fecha legible para el usuario
        const opcionesFecha: Intl.DateTimeFormatOptions = {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        };
        const fechaLegible = startDateTime.toLocaleDateString(
          "es-ES",
          opcionesFecha,
        );
        const horaLegible = startDateTime.toLocaleTimeString("es-ES", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: true,
        });

        if (scheduleSuccessDetails) {
          scheduleSuccessDetails.innerHTML = `<strong>${fechaLegible}</strong> a las <strong>${horaLegible}</strong><br><span style="font-size:0.88rem; color:#aaa;">Vinculado a ${clientEmail} y ${CREW_EMAIL}</span>`;
        }

        // Mostrar exclusivamente la tarjeta de éxito limpia (ocultando header y form)
        if (scheduleHeader) scheduleHeader.classList.add("hidden");
        if (scheduleForm) scheduleForm.classList.add("hidden");
        if (scheduleSuccessCard) scheduleSuccessCard.classList.remove("hidden");
        if (scheduleStatusEl) scheduleStatusEl.textContent = "";
      } catch (err) {
        console.error(err);
        if (scheduleStatusEl)
          scheduleStatusEl.textContent =
            "Ocurrió un error. Intenta nuevamente.";
      }
    });
  }
</script>
