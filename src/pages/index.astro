    overflow: hidden;
  }

  .schedule-call-btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .schedule-call-btn:hover {
    background-color: #f1cd00;
    color: #000;
    box-shadow:
      0 0 25px rgba(241, 205, 0, 0.6),
      0 0 45px rgba(241, 205, 0, 0.35);
