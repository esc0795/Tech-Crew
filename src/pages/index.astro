---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html>
  <head>
    <meta charset="UTF-8" />
    <title>Tech Crew - CR</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Tech-Crew/tc.png" />
    <link rel="shortcut icon" type="image/png" href="/Tech-Crew/tc.png" />
    <link rel="apple-touch-icon" href="/Tech-Crew/tc.png" />
    <link rel="stylesheet" href="/Tech-Crew/global.css" />
  </head>

  <body>
    <Header />
    <!-- FONDO GLOBAL ANIMADO -->
    <canvas id="global-canvas"></canvas>

    <!-- HERO PRINCIPAL -->
    <div class="hero-section">
      <div class="hero-container">
        <div class="hero-content">
          <h3>
            Llevamos tu Negocio al Mundo Digital
          </h3>
          <p class="hero-subtitle">
            Sitios web r&aacute;pidos, modernos y listos para vender, dise&ntilde;ados para captar clientes y potenciar tus conversiones de forma automatizada.
          </p>
          <a href="#soluciones" id="cta-button" class="cta-button"
            >Conocer m&aacute;s</a
          >
        </div>
        <div class="hero-visual">
          <img src="/Tech-Crew/tech_mockup.jpg" alt="Maqueta Digital de Sitio Web Moderno en MacBook e iPhone" class="hero-mockup-img" />
        </div>
      </div>
    </div>

    <!-- SECCIÓN DE IMPACTO, ESTADÍSTICAS Y CASOS DE ÉXITO -->
    <section class="stats-section" id="catalogo">
      <div class="stats-header">
        <h2>Impacto real en tu negocio y marca personal</h2>
      </div>

      <div class="stats-grid">
        <!-- Caso 1: Ventas y Tienda con WhatsApp Automatizado -->
        <div class="stat-card">
          <div class="stat-card-top">
            <span class="card-chip">WhatsApp &amp; E-Commerce</span>
            <div class="stat-metric">-75%</div>
            <div class="stat-metric-label">
              Tiempo en atenci&oacute;n y filtrado
            </div>
          </div>
          <div class="stat-card-body">
            <h4>Ventas Automatizadas por WhatsApp</h4>
            <p>
              Elimina la fricci&oacute;n de responder manualmente cada mensaje
              sobre tallas, disponibilidad y precios. Conectamos una tienda web
              donde el cliente elige y env&iacute;a el pedido listo para pagar
              directo a tu WhatsApp.
            </p>
            <div class="stat-features">
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span
                  >Filtro autom&aacute;tico de tallas, stock y cat&aacute;logo</span
                >
              </div>
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span>Cierre de venta inmediato sin demoras 24/7</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Caso 2: CVs Web Optimizados para IA / Sistemas ATS -->
        <div class="stat-card">
          <div class="stat-card-top">
            <span class="card-chip">Empleabilidad &amp; Marca</span>
            <div class="stat-metric">+300%</div>
            <div class="stat-metric-label">
              Visibilidad ante reclutadores e IA
            </div>
          </div>
          <div class="stat-card-body">
            <h4>CVs Web Optimizados para IA / ATS</h4>
            <p>
              Los sistemas de reclutamiento actuales filtran candidatos mediante
              Inteligencia Artificial. Dise&ntilde;amos tu CV en l&iacute;nea
              con estructura y metadatos adaptados para superar filtros ATS y
              destacar profesionalmente.
            </p>
            <div class="stat-features">
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span>Estructura 100% compatible con lectores ATS e IA</span>
              </div>
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span>Enlace web propio interactivo y de alto impacto</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Caso 3: Menús Web para Restaurantes (To-Go & Salón) -->
        <div class="stat-card">
          <div class="stat-card-top">
            <span class="card-chip">Gastronom&iacute;a Digital</span>
            <div class="stat-metric">+25%</div>
            <div class="stat-metric-label">
              Ticket promedio y rotaci&oacute;n
            </div>
          </div>
          <div class="stat-card-body">
            <h4>Men&uacute;s Web y Pedidos To-Go</h4>
            <p>
              Men&uacute;s interactivos r&aacute;pidos por QR o enlace web.
              Desde cartas digitales informativas hasta sistemas con
              selecci&oacute;n de platillos que cierran la orden directo
              v&iacute;a WhatsApp para sal&oacute;n o servicio to-go.
            </p>
            <div class="stat-features">
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span
                  >Actualizaci&oacute;n de precios y platos en tiempo real</span
                >
              </div>
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span
                  >Cero costos de reimpresi&oacute;n y pedidos sin
                  intermediarios</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Caso 4: Landing Pages de Alta Conversión -->
        <div class="stat-card">
          <div class="stat-card-top">
            <span class="card-chip">Conversi&oacute;n &amp; Leads</span>
            <div class="stat-metric">3.5x</div>
            <div class="stat-metric-label">
              M&aacute;s conversi&oacute;n de prospectos
            </div>
          </div>
          <div class="stat-card-body">
            <h4>Landing Pages de Alta Conversi&oacute;n</h4>
            <p>
              P&aacute;ginas estrat&eacute;gicas enfocadas en convertir visitas
              en clientes reales. Arquitectura persuasiva y velocidad extrema
              para maximizar el retorno de tu publicidad y presencia web.
            </p>
            <div class="stat-features">
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span
                  >Enfoque directo en captaci&oacute;n de leads cualificados</span
                >
              </div>
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span
                  >Carga instant&aacute;nea optimizada para dispositivos
                  m&oacute;viles</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Caso 5: Digitalización Integral para Negocios -->
        <div class="stat-card">
          <div class="stat-card-top">
            <span class="card-chip">Transformaci&oacute;n Digital</span>
            <div class="stat-metric">24/7</div>
            <div class="stat-metric-label">
              Presencia activa y tr&aacute;fico controlado
            </div>
          </div>
          <div class="stat-card-body">
            <h4>Digitalizaci&oacute;n Integral de Negocios</h4>
            <p>
              Llevamos tu negocio tradicional, cat&aacute;logo o producto
              f&iacute;sico al ecosistema digital con bajo costo por
              tr&aacute;fico controlado, permiti&eacute;ndote competir y escalar
              con tecnolog&iacute;a moderna.
            </p>
            <div class="stat-features">
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span>Automatizaci&oacute;n de procesos repetitivos</span>
              </div>
              <div class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span>Estrategias adaptadas al presupuesto de tu negocio</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE SOLUCIONES RENOVADA -->
    <section class="soluciones-section" id="soluciones">
      <div class="soluciones-header">
        <a
          id="schedule-call-btn"
          class="schedule-call-btn"
          aria-label="Agendar llamada de consultoría"
        >
          <svg
            class="calendar-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Agendar llamada</span>
        </a>
        <h2>Soluciones digitales a tu medida</h2>
      </div>

      <div class="solution-cards">
        <!-- 1. Landing Pages y SEO -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <div class="header-info">
              <span class="solution-chip"
                >Conversi&oacute;n &amp; Tr&aacute;fico</span
              >
              <span class="solution-title"
                >Landing Pages y Posicionamiento SEO</span
              >
            </div>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <div class="card-content-inner">
              <p>
                Dise&ntilde;amos p&aacute;ginas de aterrizaje de alto
                rendimiento combinadas con optimizaci&oacute;n para motores de
                b&uacute;squeda (SEO). Estructuramos cada secci&oacute;n con
                psicolog&iacute;a de conversi&oacute;n y palabras clave
                estrat&eacute;gicas para que tu negocio aparezca en Google y
                convierta visitas en prospectos y clientes reales.
              </p>
              <div class="solution-bullets">
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Optimizaci&oacute;n t&eacute;cnica y posicionamiento
                    org&aacute;nico en Google</span
                  >
                </div>
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Estructura persuasiva de alta conversi&oacute;n para
                    campa&ntilde;as y anuncios</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Documentos Digitales (Menús y CVs) -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <div class="header-info">
              <span class="solution-chip">Men&uacute;s QR &amp; CVs con IA</span
              >
              <span class="solution-title"
                >Documentos Digitales Inteligentes (Men&uacute;s y CVs)</span
              >
            </div>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <div class="card-content-inner">
              <p>
                Modernizamos la presentaci&oacute;n de tu negocio
                gastron&oacute;mico y tu perfil profesional:
              </p>
              <div class="solution-bullets">
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    ><strong>Men&uacute;s Web para Restaurantes:</strong> Cartas
                    interactivas por c&oacute;digo QR con actualizaci&oacute;n instant&aacute;nea
                    y carrito para recibir pedidos directos a WhatsApp (to-go y sal&oacute;n).</span
                  >
                </div>
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    ><strong>CVs Optimizados para IA / ATS:</strong> Curr&iacute;culums
                    web interactivos con el formato exacto requerido por los algoritmos
                    de reclutamiento para evitar ser descartado y destacar ante empleadores.</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Sitios Web y Tiendas con WhatsApp -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <div class="header-info">
              <span class="solution-chip"
                >E-Commerce &amp; Cat&aacute;logos</span
              >
              <span class="solution-title"
                >Sitios Web y Tiendas con Cierre en WhatsApp</span
              >
            </div>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <div class="card-content-inner">
              <p>
                Desarrollo de sitios web corporativos y tiendas en l&iacute;nea
                con cat&aacute;logos interactivos. Automatizamos el proceso
                inicial de venta: el cliente explora, filtra tallas, colores o
                disponibilidad y env&iacute;a el pedido listo para pagar
                directamente a tu WhatsApp, ahorr&aacute;ndote horas de
                respuesta manual.
              </p>
              <div class="solution-bullets">
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Cat&aacute;logos con selecci&oacute;n y filtrado
                    autom&aacute;tico de producto</span
                  >
                </div>
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Finalizaci&oacute;n de compra por WhatsApp sin costos de
                    comisi&oacute;n por pasarela</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Digitalización Integral para Negocios -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <div class="header-info">
              <span class="solution-chip"
                >Transformaci&oacute;n &amp; Automatizaci&oacute;n</span
              >
              <span class="solution-title"
                >Digitalizaci&oacute;n Integral para Negocios y Emprendedores</span
              >
            </div>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <div class="card-content-inner">
              <p>
                Acompa&ntilde;amos a emprendedores y negocios en su
                transici&oacute;n al ecosistema digital. Orientamos la presencia
                de tu marca hacia modelos rentables de bajo costo por
                tr&aacute;fico controlado, automatizando procesos repetitivos y
                creando activos digitales escalables.
              </p>
              <div class="solution-bullets">
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Estrategias adaptadas al presupuesto de emprendedores</span
                  >
                </div>
                <div class="solution-bullet">
                  <span class="bullet-check">&#10003;</span>
                  <span
                    >Integraci&oacute;n de herramientas digitales y soporte
                    estrat&eacute;gico continuo</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Modal de Contacto -->
    <div id="contact-modal" class="modal-overlay">
      <div class="modal-content">
        <button class="modal-close" id="modal-close">X</button>

        <h2>Cont&aacute;ctanos</h2>

        <form id="modal-contact-form">
          <label>
            Nombre
            <input type="text" name="nombre" required />
          </label>

          <label>
            Correo electr&oacute;nico
            <input type="email" name="email" required />
          </label>

          <label>
            WhatsApp/Tel&eacute;fono
            <input type="tel" name="telefono" required />
          </label>

          <label>
            Medio de contacto de preferencia
            <select name="medio_contacto" required>
              <option value="" disabled selected
                >Seleccione una opci&oacute;n</option
              >
              <option value="WhatsApp">WhatsApp</option>
              <option value="Correo">Correo Electr&oacute;nico</option>
            </select>
          </label>

          <button type="submit" class="send-btn">Enviar</button>
        </form>
        <p id="modal-status" style="margin-top:10px; color:#f5c400;"></p>
      </div>
    </div>

    <!-- MODAL DE AGENDAR LLAMADA CON GOOGLE CALENDAR -->
    <div id="schedule-modal" class="modal-overlay">
      <div class="modal-content schedule-modal-content">
        <button
          class="modal-close"
          id="schedule-modal-close"
          aria-label="Cerrar">&times;</button
        >

        <div class="schedule-modal-header" id="schedule-modal-header">
          <div class="schedule-icon-badge">
            <svg
              class="modal-calendar-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h2>Agendar Llamada</h2>
          <p class="schedule-modal-subtitle">
            Selecciona el d&iacute;a y la hora para tu sesi&oacute;n de
            consultor&iacute;a estrat&eacute;gica.
          </p>
        </div>

        <form id="schedule-call-form">
          <label>
            Nombre completo *
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>

          <div class="form-grid-2">
            <label>
              Correo electr&oacute;nico *
              <input
                type="email"
                name="email"
                placeholder="tu@correo.com"
                required
              />
            </label>

            <label>
              WhatsApp / Tel&eacute;fono *
              <input
                type="tel"
                name="telefono"
                placeholder="+506 8888-8888"
                required
              />
            </label>
          </div>

          <div class="form-grid-2">
            <label>
              Fecha de la llamada *
              <input type="date" id="schedule-date" name="fecha" required />
            </label>

            <label>
              Hora preferida *
              <select name="hora" id="schedule-time" required>
                <option value="" disabled selected>Elige una fecha primero</option>
              </select>
            </label>
          </div>

          <label>
            Soluci&oacute;n de inter&eacute;s principal
            <select name="servicio_interes" required>
              <option value="Ventas Automatizadas por WhatsApp"
                >Ventas Automatizadas por WhatsApp / Tienda Web</option
              >
              <option value="Menús Web para Restaurantes"
                >Men&uacute;s Web para Restaurantes (QR &amp; WhatsApp)</option
              >
              <option value="CV Web Optimizado para IA / ATS"
                >CV Web Optimizado para IA / ATS</option
              >
              <option value="Landing Pages y SEO"
                >Landing Pages y Posicionamiento SEO</option
              >
              <option value="Digitalización Integral de Negocio"
                >Digitalizaci&oacute;n Integral de Negocio</option
              >
              <option value="Otra Consulta"
                >Otra Consulta / Asesor&iacute;a General</option
              >
            </select>
          </label>

          <button
            type="submit"
            id="schedule-submit-btn"
            class="send-btn schedule-submit-btn"
          >
            <span>Confirmar</span>
          </button>
        </form>

        <!-- ESTADO DE CARGA: AGENDANDO EN SEGUNDO PLANO -->
        <div id="schedule-loading-card" class="schedule-loading-card hidden">
          <div class="schedule-spinner"></div>
          <h3>Agendando llamada...</h3>
          <p id="schedule-loading-details">
            Sincronizando evento en Google Calendar con ambos correos.
          </p>
          <div class="loading-progress-badge">
            <span class="loading-pulse"></span>
            <span>Creando evento en agenda...</span>
          </div>
        </div>

        <!-- ESTADO DE ÉXITO: EVENTO CREADO + BOTÓN WHATSAPP -->
        <div id="schedule-success-card" class="schedule-success-card hidden">
          <div class="success-icon">&#10003;</div>
          <h3>&iexcl;Llamada Agendada con &Eacute;xito!</h3>
          <p id="schedule-success-details"></p>
        </div>

        <p
          id="schedule-status"
          style="margin-top:12px; color:#f5c400; text-align:center;"
        >
        </p>
      </div>
    </div>

    <!-- FOOTER -->
    <Footer />
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Geist:wght@100&display=swap");

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: "Geist", sans-serif;
    background: #000;
    color: #fff;
  }

  /* HERO */
  .hero-section {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 140px 2rem 4rem 2rem;
    background-color: transparent;
    box-sizing: border-box;
  }

  #global-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background: #000;
  }

  .hero-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    color: rgb(255, 255, 255);
    gap: 1.8rem;
    text-align: left;
  }

  .hero-content h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.15;
    margin: 0;
    max-width: 800px;
    letter-spacing: -1.5px;
    background: linear-gradient(135deg, #ffffff 30%, #a0a0a0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    color: #b0b0b0;
    max-width: 650px;
    margin: 0;
    line-height: 1.6;
    font-weight: 400;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .hero-mockup-img {
    width: 100%;
    max-width: 400px;
    height: auto;
    transform: perspective(1000px) rotateY(-8deg) rotateX(6deg);
    transition: transform 0.5s ease;
    mix-blend-mode: screen;
    filter: brightness(0.85) contrast(1.5);
  }

  .hero-mockup-img:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) scale(1.03);
  }

  /* Breakpoints responsivos */
  @media (max-width: 968px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-mockup-img {
      transform: none;
      max-width: 450px;
    }

    .hero-mockup-img:hover {
      transform: scale(1.02);
    }
  }

  @media (max-width: 550px) {
    .hero-section {
      padding-top: 110px;
    }
    .hero-mockup-img {
      max-width: 100%;
    }
  }

  .soluciones-section h3 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }

  .cta-button {
    position: relative;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid #f1cd00;
    padding: 1.2rem 2.5rem;
    font-size: 1.4rem;
    font-weight: bold;
    color: #f1cd00;
    cursor: pointer;
    transition: all 0.4s ease;
    border-radius: 50px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    width: auto;
    overflow: hidden;
    backdrop-filter: blur(5px);
    box-shadow:
      0 0 10px rgba(241, 205, 0, 0.2),
      inset 0 0 10px rgba(241, 205, 0, 0.1);
  }

  .cta-button::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .cta-button:hover {
    background-color: #f1cd00;
    color: #000;
    box-shadow:
      0 0 20px rgba(241, 205, 0, 0.6),
      0 0 40px rgba(241, 205, 0, 0.4);
    transform: translateY(-3px);
  }

  .cta-button:hover::after {
    left: 150%;
  }

  /* SECCIÓN DE IMPACTO, ESTADÍSTICAS Y CASOS DE ÉXITO */
  .stats-section {
    position: relative;
    z-index: 10;
    overflow: visible;
    background: transparent;
    padding: 6rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .stats-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .stats-badge {
    display: inline-block;
    background: rgba(241, 205, 0, 0.1);
    border: 1px solid rgba(241, 205, 0, 0.4);
    color: #f1cd00;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    margin-bottom: 1.2rem;
    backdrop-filter: blur(8px);
  }

  .stats-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .stats-subtitle {
    font-size: 1.15rem;
    color: #b0b0b0;
    line-height: 1.6;
    margin: 0;
  }

  .stats-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .stat-card {
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(241, 205, 0, 0.25);
    border-radius: 14px;
    padding: 2.2rem 1.8rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #f1cd00, transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .stat-card:hover {
    transform: translateY(-7px);
    border-color: rgba(241, 205, 0, 0.7);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.8),
      0 0 25px rgba(241, 205, 0, 0.18);
  }

  .stat-card:hover::before {
    opacity: 1;
  }

  .stat-card-top {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1.5rem;
  }

  .card-chip {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #f1cd00;
    background: rgba(241, 205, 0, 0.1);
    border: 1px solid rgba(241, 205, 0, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    margin-bottom: 1rem;
  }

  .stat-metric {
    font-size: 2.8rem;
    font-weight: 900;
    color: #f1cd00;
    line-height: 1;
    margin-bottom: 0.3rem;
    letter-spacing: -1px;
    text-shadow: 0 0 20px rgba(241, 205, 0, 0.35);
  }

  .stat-metric-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #e0e0e0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stat-card-body h4 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.8rem 0;
    line-height: 1.3;
  }

  .stat-card-body p {
    font-size: 0.98rem;
    color: #bbb;
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  .stat-features {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: #e5e5e5;
    line-height: 1.4;
  }

  .check-icon {
    color: #f1cd00;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* SOLUCIONES RENOVADAS */
