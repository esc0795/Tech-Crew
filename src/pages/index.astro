---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Header />

<html>
  <head>
    <meta charset="UTF-8">
    <title>Tech Crew</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />\
    <link rel="stylesheet" href="/Tech-Crew/global.css" />
  </head>

  <body>
    <!-- HERO PRINCIPAL -->
    <div class="hero-section">
      <div class="hero-content">
        <h3>
          CRECEMOS<br>
          INCENTIVANDO<br>
          A CRECER
        </h3>
        <a href="#soluciones" id="cta-button" class="cta-button">Conocer mas</a>
      </div>
    </div>

    <!-- SECCIÓN DE REDES SOCIALES -->
    <section class="social-section" id="social">
      <h3>Socios</h3>
      <div class="socios-section">
        <img src="automercado.png" alt="Automercado" width="150" />
        <img src="gymshark.jpg" alt="Gymshark" width="150" />
        <img src="smartfit.png" alt="Smartfit" width="150" />
        <img src="chery.png" alt="Chery" width="150" />
        <img src="muscletech.jpg" alt="Muscletech" width="150" />
        <img src="BYD.jpg" alt="Byd" width="150" />
      </div>
    </section>

    <!-- SECCIÓN DE SOLUCIONES -->
    <section class="soluciones-section" id="soluciones">
      <h3>Nuestras Soluciones</h3>
      <div class="solution-cards">
        <!-- Card: Landing Pages -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Landing Pages</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>Disenamos landing pages optimizadas para captar clientes potenciales y aumentar conversiones.</p>
          </div>
        </div>

        <!-- Card: SEO -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>SEO</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>Posicionamos tu web para aparecer primero en Google y atraer trafico de calidad.</p>
          </div>
        </div>

        <!-- Card: Despliegues -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Sitios web</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>Crecion de sitios web segun necesidades del cliente.</p>
          </div>
        </div>
         <!-- Card: Despliegues -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Digitalizacion para emprendedores</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>Orientamos el camino de tu negocio hacia la digitalizacion, basados en el bajo costo por trafico controlado.</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Modal Overlay -->
  <div id="contact-modal" class="modal-overlay">
    <div class="modal-content">
     <button class="modal-close" id="modal-close">X</button>
    
      <h2>Contactanos</h2>

      <form id="modal-contact-form">
       <label>
          Nombre
          <input type="text" name="nombre" required>
        </label>

        <label>
          Correo electronico
          <input type="email" name="email" required>
        </label>

        <label>
          Whatsapp/Telefono
          <input type="tel" name="telefono" required>
        </label>

        <label>
          Mensaje
          <textarea name="mensaje" rows="4" required></textarea>
        </label>

        <button type="submit" class="send-btn">Enviar</button>
      </form>
      <p id="modal-status" style="margin-top:10px; color:#f5c400;"></p>
    </div>
  </div>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100&display=swap');

  body {
    margin: 0;
    font-family: 'Geist', sans-serif;
    background: #000;
    color: #fff;
  }

  /* HERO */
  .hero-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-top: 5rem;
    padding: 9% 2rem;
    background-color: #000;
    flex-wrap: wrap;
    background-image: url("/Tech-Crew/imgbcknd.png");
    background-size: cover;
    background-position: left center;
    background-repeat: no-repeat;
    padding-left: 5em;
    width: 100%;
    height:40em;
    text-align: justify;
  }

  .hero-image {
    max-width: 45%;
    margin-right: 5%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items:flex-start;
    margin-left: 22.5em;
    margin-top: -12em;
    max-width: 60%;
    color: rgb(255, 255, 255);
    gap: 0.3rem;
    margin-bottom: 10em;
  }

  .hero-content h3 {
    font-size: 4rem;
    font-weight: 900;
    padding-bottom: 2rem;
  }

  .social-section h3 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }

  .soluciones-section h3 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }

  .cta-button {
    background-color: #f1cd00;
    border: none;
    padding: 1.2rem 2rem;
    font-size: 1.6rem;
    font-weight: bold;
    color: black;
    cursor: pointer;
    transition: background-color 0.3s ease;
    border-radius: 5px;
    text-decoration: none;

    /* ELIMINAR LOS VALORES QUE DAÑABAN LA POSICIÓN */
    margin: 0;
    width: auto;

    /* BOTÓN A LA IZQUIERDA */
    align-self: flex-start;
  }


  .cta-button:hover {
    background-color: #fdf6f6;
  }

  /* REDES SOCIALES */
  .social-section {
    background-size: cover;
    background-color: #000000; /* fallback color */
    text-align: center;
    padding: 4rem 2rem;
  }

  .social-section h4 {
    font-size: 2.9rem;
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .socios-section {
    display: flex;
    justify-content: center;
    margin-top: 6em;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .social-links a {
    color: #f1d430;
    text-decoration: none;
    font-size: 2rem;
    font-weight: bold;
  }

  .social-links a:hover {
    color: #ffffff;
  }

  /* SOLUCIONES */
  .soluciones-section {
    background: #000;
    color: white;
    text-align: center;
    padding: 6rem 2rem;
  }

  .soluciones-section h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .solution-cards {
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }

  .solution-card {
    background: #111;
    border: 1px solid #ffff5c;
    border-radius: 8px;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-size: 1.5rem;
    background: #000000;
  }

  .card-header:hover {
    background: #38331c;
  }

  .icon {
    transition: transform 0.3s ease;
  }

  .card-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 1.5rem;
  }

  .card-content p {
    margin: 1rem 0;
  }

  .solution-card.open .card-content {
    max-height: 200px;
    padding: 1rem 1.5rem;
  }

  .solution-card.open .icon {
    transform: rotate(45deg);
  }

  /* Overlay oscuro */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Caja del modal */
  .modal-content {
    background: #111;
    color: #fff;
    padding: 2rem;
    margin-top: 180px;
    border-radius: 10px;
    width: 90%;
    max-width: 450px;
    position: relative;
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.1);
    animation: modalPop .35s ease;
  }

@keyframes modalPop {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

  /* Botón cerrar */
  .modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Inputs */
  .modal-content input,
  .modal-content textarea {
    width: 100%;
    padding: .7rem;
    margin-top: .3rem;
    margin-bottom: 1rem;
    border: none;
    border-radius: 6px;
    background: #222;
    color: #fff;
  }

/* Botón enviar */
  .send-btn {
    background: #f5c400;
    color: #000;
    padding: .8rem 1.6rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
    transition: opacity .2s ease;
  }

  .send-btn:hover {
    opacity: 0.8;
    background-color: #fdf6f6;
  }

  /* Oculto */
  .hidden {
    display: none;
  }


  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-section {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1rem;
    }

    .hero-image {
      max-width: 100%;
      margin-bottom: 2rem;
    }

    .hero-content {
      align-items: center;
    }

    .hero-content h3 {
      font-size: 2rem;
    }

    .cta-button {
      font-size: 1.2rem;
      padding: 1rem 2rem;
      width: auto;
    
      /* CENTRADO EN MÓVIL */
      align-self: center;
      margin: 1rem 0;
    }

    .social-section {
      padding: 3rem 1rem;
    }

    .social-section h4 {
      font-size: 2rem;
    }

    .social-links {
      flex-direction: column;
      gap: 1rem;
    }

    .social-links a {
      font-size: 1.2rem;
    }

    .soluciones-section h2 {
      font-size: 2rem;
    }
  }
</style>

<script type="module">
  // ---------------------------
  // Toggle de tarjetas
  // ---------------------------
  function toggleCard(header) {
    const card = header.closest('.solution-card');
    if (card) {
      card.classList.toggle('open');
    }
  }
  window.toggleCard = toggleCard;


  // ---------------------------
  // Modal
  // ---------------------------
  const openBtn = document.querySelector('#open-modal-btn');
  const modal = document.querySelector('#contact-modal');
  const closeBtn = document.querySelector('#modal-close');
  const form = document.querySelector('#modal-contact-form');
  const statusEl = document.querySelector('#modal-status');

  openBtn.addEventListener("click", (e) => {
    e.preventDefault();
    modal.classList.add("active");
  });

  closeBtn.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.classList.remove("active");
  });


  // ---------------------------
  // Google Sheets
  // ---------------------------
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz8YJmjhHiEXD-o3iYDErabiZ-vZITA7lXqTtAIUVHJL9hyDw4ATbqY7YX8FYEInsWW/exec";

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    statusEl.textContent = "Enviando...";

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch(SCRIPT_URL, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8"
        },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error("Error en servidor AS");

      statusEl.textContent = "Mensaje enviado! Pronto te contactaremos";

      form.reset();

      setTimeout(() => {
        modal.classList.remove("active");
        statusEl.textContent = "";
      }, 1500);

    } catch (err) {
      console.error(err);
      statusEl.textContent = "Error al enviar. Intenta de nuevo.";
    }
  });
</script>


