---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<html>
  <head>
    <meta charset="UTF-8" />
    <title>Tech Crew</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/Tech-Crew/global.css" />
  </head>

  <body>
    <Header />
    <!-- FONDO GLOBAL ANIMADO -->
    <canvas id="global-canvas"></canvas>

    <!-- HERO PRINCIPAL -->
    <div class="hero-section">
      <div class="hero-content">
        <h3>
          CRECEMOS<br />
          INCENTIVANDO<br />
          A CRECER
        </h3>
        <a href="#soluciones" id="cta-button" class="cta-button"
          >Conocer m&aacute;s</a
        >
      </div>
    </div>

    <!-- NUEVO CATÁLOGO DE SERVICIOS -->
    <section class="catalog-section" id="catalogo">
      <div class="catalog-slider">
        <div class="catalog-card">
          <h4>Automatizaciones con IA</h4>
          <p>
            Integraci&oacute;n de agentes inteligentes y procesos
            autom&aacute;ticos para hacer tu negocio m&aacute;s &aacute;gil.
          </p>
        </div>

        <div class="catalog-card">
          <h4>Transformaci&oacute;n digital</h4>
          <p>
            Moderniza las herramientas y estrategias para destacar en el
            ecosistema digital actual.
          </p>
        </div>

        <div class="catalog-card">
          <h4>Por qu&eacute; es importante el SEO</h4>
          <p>
            Posicionamiento org&aacute;nico y visibilidad en buscadores para que
            te encuentren primero.
          </p>
        </div>

        <div class="catalog-card">
          <h4>Optimizaci&oacute;n de ventas en l&iacute;nea</h4>
          <p>
            Estrategias probadas para maximizar conversiones y mejorar la
            experiencia de usuario.
          </p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE SOLUCIONES -->
    <section class="soluciones-section" id="soluciones">
      <h3>Nuestras Soluciones</h3>
      <div class="solution-cards">
        <!-- Card: Landing Pages -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Landing Pages</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>
              Dise&ntilde;amos landing pages optimizadas para captar clientes
              potenciales y aumentar conversiones.
            </p>
          </div>
        </div>

        <!-- Card: SEO -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>SEO</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>
              Posicionamos tu web para aparecer primero en Google y atraer
              tr&aacute;fico de calidad.
            </p>
          </div>
        </div>

        <!-- Card: Sitios Web -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Sitios web</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>
              Creaci&oacute;n de sitios web seg&uacute;n necesidades del
              cliente.
            </p>
          </div>
        </div>
        <!-- Card: Digitalización -->
        <div class="solution-card">
          <div class="card-header" onclick="toggleCard(this)">
            <span>Digitalizaci&oacute;n para emprendedores</span>
            <span class="icon">+</span>
          </div>
          <div class="card-content">
            <p>
              Orientamos el camino de tu negocio hacia la digitalizaci&oacute;n,
              basados en el bajo costo por tr&aacute;fico controlado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Modal Overlay -->
    <div id="contact-modal" class="modal-overlay">
      <div class="modal-content">
        <button class="modal-close" id="modal-close">X</button>

        <h2>Cont&aacute;ctanos</h2>

        <form id="modal-contact-form">
          <label>
            Nombre
            <input type="text" name="nombre" required />
          </label>

          <label>
            Correo electr&oacute;nico
            <input type="email" name="email" required />
          </label>

          <label>
            WhatsApp/Tel&eacute;fono
            <input type="tel" name="telefono" required />
          </label>

          <label>
            Medio de contacto de preferencia
            <select name="medio_contacto" required>
              <option value="" disabled selected
                >Seleccione una opci&oacute;n</option
              >
              <option value="WhatsApp">WhatsApp</option>
              <option value="Correo">Correo Electr&oacute;nico</option>
            </select>
          </label>

          <button type="submit" class="send-btn">Enviar</button>
        </form>
        <p id="modal-status" style="margin-top:10px; color:#f5c400;"></p>
      </div>
    </div>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  @import url("https://fonts.googleapis.com/css2?family=Geist:wght@100&display=swap");

  body {
    margin: 0;
    font-family: "Geist", sans-serif;
    background: #000;
    color: #fff;
  }

  /* HERO */
  .hero-section {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 0 2rem;
    background-color: transparent;
    text-align: center;
  }

  #global-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background: #000;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 800px;
    margin: 0 auto;
    color: rgb(255, 255, 255);
    gap: 1.5rem;
    text-align: left;
  }

  .hero-content h3 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.2;
    margin: 0;
  }

  .soluciones-section h3 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }

  .cta-button {
    position: relative;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid #f1cd00;
    padding: 1.2rem 2.5rem;
    font-size: 1.4rem;
    font-weight: bold;
    color: #f1cd00;
    cursor: pointer;
    transition: all 0.4s ease;
    border-radius: 50px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    width: auto;
    overflow: hidden;
    backdrop-filter: blur(5px);
    box-shadow:
      0 0 10px rgba(241, 205, 0, 0.2),
      inset 0 0 10px rgba(241, 205, 0, 0.1);
  }

  .cta-button::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .cta-button:hover {
    background-color: #f1cd00;
    color: #000;
    box-shadow:
      0 0 20px rgba(241, 205, 0, 0.6),
      0 0 40px rgba(241, 205, 0, 0.4);
    transform: translateY(-3px);
  }

  .cta-button:hover::after {
    left: 150%;
  }

  /* NUEVO CATÁLOGO DE SERVICIOS */
  .catalog-section {
    position: relative;
    z-index: 10;
    overflow: visible; /* Or visible if we want no cutoff at all */
    background: transparent;
    padding: 6rem 2rem;
    text-align: center;
  }

  .catalog-slider {
    position: relative;
    z-index: 1;
    display: flex;
    overflow-x: auto;
    gap: 2rem;
    padding-top: 10px; /* Previene el corte del hover superior */
    padding-bottom: 2rem;
    scrollbar-width: none;
    -ms-overflow-style: none; /* IE and Edge */
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
  }

  .catalog-slider::-webkit-scrollbar {
    display: none;
  }

  .catalog-card {
    flex: 0 0 300px;
    background: #050505;
    border: 1px solid rgba(241, 205, 0, 0.4); /* Línea amarilla muy delgada */
    border-radius: 8px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .catalog-card:hover {
    transform: translateY(-5px);
    border-color: rgba(241, 205, 0, 1);
  }

  .catalog-card h4 {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    color: #f1cd00;
  }

  .catalog-card p {
    font-size: 1rem;
    color: #ccc;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  /* SOLUCIONES */
  .soluciones-section {
    position: relative;
    z-index: 10;
    background: transparent;
    color: white;
    text-align: center;
    padding: 6rem 2rem;
  }

  .soluciones-section h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .solution-cards {
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }

  .solution-card {
    background: #111;
    border: 1px solid #ffff5c;
    border-radius: 8px;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-size: 1.5rem;
    background: #000000;
  }

  .card-header:hover {
    background: #38331c;
  }

  .icon {
    transition: transform 0.3s ease;
  }

  .card-content {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease,
      padding 0.3s ease;
    padding: 0 1.5rem;
  }

  .card-content p {
    margin: 1rem 0;
  }

  .solution-card.open .card-content {
    max-height: 200px;
    padding: 1rem 1.5rem;
  }

  .solution-card.open .icon {
    transform: rotate(45deg);
  }

  /* Overlay oscuro */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Caja del modal */
  .modal-content {
    box-sizing: border-box;
    background: rgba(10, 10, 10, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(241, 205, 0, 0.2);
    color: #fff;
    padding: 2rem 1.5rem;
    border-radius: 12px;
    width: 90%;
    max-width: 400px;
    max-height: 85vh;
    overflow-y: auto;
    position: relative;
    box-shadow:
      0 0 40px rgba(0, 0, 0, 0.8),
      inset 0 0 20px rgba(255, 255, 255, 0.05);
    animation: modalPop 0.35s ease;
  }

  @keyframes modalPop {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Botón cerrar */
  .modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Inputs */
  .modal-content input,
  .modal-content select,
  .modal-content textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem;
    margin-top: 0.3rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    transition:
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .modal-content select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1em;
  }

  .modal-content select option {
    background: #111;
    color: #fff;
  }

  .modal-content input:focus,
  .modal-content select:focus,
  .modal-content textarea:focus {
    outline: none;
    border-color: #f1cd00;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Botón enviar */
  .send-btn {
    background: #f5c400;
    color: #000;
    padding: 0.8rem 1.6rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
    transition: opacity 0.2s ease;
  }

  .send-btn:hover {
    opacity: 0.8;
    background-color: #fdf6f6;
  }

  /* Oculto */
  .hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 6rem 1rem 3rem 1rem;
    }

    .hero-content h3 {
      font-size: 2.5rem;
    }

    .cta-button {
      font-size: 1.1rem;
      padding: 1rem 2rem;
    }

    .catalog-section {
      padding: 3rem 1rem;
    }

    .catalog-slider {
      gap: 1.5rem;
      padding-bottom: 1rem;
    }

    .catalog-card {
      flex: 0 0 260px; /* Tarjetas más pequeñas en móvil */
      padding: 1.5rem;
    }

    .soluciones-section h2 {
      font-size: 2rem;
    }
  }
</style>

<script type="module">
  // ---------------------------
  // Canvas Tech Animation
  // ---------------------------
  const canvas = document.getElementById("global-canvas");
  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width, height;
    let particles = [];

    function initCanvas() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      particles = [];
      const numParticles = Math.floor((width * height) / 8000);
      for (let i = 0; i < numParticles; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 1.2,
          vy: (Math.random() - 0.5) * 1.2,
          radius: Math.random() * 2 + 1,
        });
      }
    }

    function drawParticles() {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgba(241, 205, 0, 0.8)";
      ctx.lineWidth = 0.5;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist = Math.sqrt((p.x - p2.x) ** 2 + (p.y - p2.y) ** 2);
          if (dist < 120) {
            ctx.strokeStyle = `rgba(241, 205, 0, ${1 - dist / 120})`;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawParticles);
    }

    initCanvas();
    drawParticles();
    window.addEventListener("resize", initCanvas);
  }

  // ---------------------------
  // Toggle de tarjetas
  // ---------------------------
  function toggleCard(header) {
    const card = header.closest(".solution-card");
    if (card) {
      card.classList.toggle("open");
    }
  }
  window.toggleCard = toggleCard;

  // ---------------------------
  // Modal
  // ---------------------------
  const openBtn = document.querySelector("#open-modal-btn");
  const modal = document.querySelector("#contact-modal");
  const closeBtn = document.querySelector("#modal-close");
  const form = document.querySelector("#modal-contact-form");
  const statusEl = document.querySelector("#modal-status");

  openBtn.addEventListener("click", (e) => {
    e.preventDefault();
    modal.classList.add("active");
  });

  closeBtn.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.classList.remove("active");
  });

  // ---------------------------
  // Google Sheets
  // ---------------------------
  const SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbz8YJmjhHiEXD-o3iYDErabiZ-vZITA7lXqTtAIUVHJL9hyDw4ATbqY7YX8FYEInsWW/exec";

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    statusEl.textContent = "Enviando...";

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch(SCRIPT_URL, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8",
        },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error("Error en servidor AS");

      statusEl.textContent = "Mensaje enviado! Pronto te contactaremos";

      form.reset();

      setTimeout(() => {
        modal.classList.remove("active");
        statusEl.textContent = "";
      }, 1500);
    } catch (err) {
      console.error(err);
      statusEl.textContent = "Error al enviar. Intenta de nuevo.";
    }
  });
</script>
