    }

    .card-content-inner {
      padding: 1.2rem;
    }

    .solution-card {
      border: 1px solid rgba(241, 205, 0, 0.2);
    }
  }
</style>

<script>
  // ---------------------------
  // Canvas Tech Animation
  // ---------------------------
  const canvas = document.getElementById(
    "global-canvas",
  ) as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
    }

    let particles: Particle[] = [];

    function initCanvas() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      particles = [];
      const numParticles = Math.floor((width * height) / 12000) || 30;
      for (let i = 0; i < numParticles; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          radius: Math.random() * 1.5 + 0.5,
        });
      }
    }

    function drawParticles() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgba(241, 205, 0, 0.7)";
      ctx.lineWidth = 0.5;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist = Math.sqrt((p.x - p2.x) ** 2 + (p.y - p2.y) ** 2);
          if (dist < 120) {
            ctx.strokeStyle = `rgba(241, 205, 0, ${1 - dist / 120})`;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawParticles);
    }

    initCanvas();
    drawParticles();
    window.addEventListener("resize", initCanvas);
  }

  // ---------------------------
  // Toggle de tarjetas
  // ---------------------------
  function toggleCard(header: HTMLElement) {
    const card = header.closest(".solution-card");
    if (card) {
      card.classList.toggle("open");
    }
  }
  (window as unknown as { toggleCard: typeof toggleCard }).toggleCard =
    toggleCard;

  // ---------------------------
  // Modal de Contacto
  // ---------------------------
  const openContactBtn = document.querySelector<HTMLElement>("#open-modal-btn");
  const contactModal = document.querySelector<HTMLElement>("#contact-modal");
  const closeContactBtn = document.querySelector<HTMLElement>("#modal-close");
  const contactForm = document.querySelector<HTMLFormElement>(
    "#modal-contact-form",
  );
  const contactStatusEl = document.querySelector<HTMLElement>("#modal-status");

  if (openContactBtn && contactModal) {
    openContactBtn.addEventListener("click", (e) => {
      e.preventDefault();
      contactModal.classList.add("active");
    });
  }

  if (closeContactBtn && contactModal) {
    closeContactBtn.addEventListener("click", () => {
      contactModal.classList.remove("active");
    });
  }

  if (contactModal) {
    contactModal.addEventListener("click", (e) => {
      if (e.target === contactModal) contactModal.classList.remove("active");
    });
  }

  // ---------------------------
  // Modal de Agendar Llamada + Automatización
  // ---------------------------
  const scheduleHeader = document.querySelector<HTMLElement>(
    "#schedule-modal-header",
  );
  const scheduleBtn = document.querySelector<HTMLElement>("#schedule-call-btn");
  const scheduleModal = document.querySelector<HTMLElement>("#schedule-modal");
  const closeScheduleBtn = document.querySelector<HTMLElement>(
    "#schedule-modal-close",
  );
  const scheduleForm = document.querySelector<HTMLFormElement>(
    "#schedule-call-form",
  );
  const scheduleDateInput =
    document.querySelector<HTMLInputElement>("#schedule-date");
  const scheduleStatusEl =
    document.querySelector<HTMLElement>("#schedule-status");
  const scheduleLoadingCard = document.querySelector<HTMLElement>(
    "#schedule-loading-card",
  );
  const scheduleLoadingDetails = document.querySelector<HTMLElement>(
    "#schedule-loading-details",
  );
  const scheduleSuccessCard = document.querySelector<HTMLElement>(
    "#schedule-success-card",
  );
  const scheduleSuccessDetails = document.querySelector<HTMLElement>(
    "#schedule-success-details",
  );
  const waConfirmBtn = document.querySelector<HTMLAnchorElement>(
    "#whatsapp-confirm-btn",
  );
  const scheduleTimeSelect = document.querySelector<HTMLSelectElement>(
    "#schedule-time",
  );

  async function updateAvailableHours() {
    if (!scheduleDateInput || !scheduleTimeSelect) return;
    const selectedDate = scheduleDateInput.value;
    if (!selectedDate) return;

    // Colocar estado de carga inicial en la selección de horas
    scheduleTimeSelect.innerHTML = '<option value="" disabled selected>Cargando disponibilidad...</option>';

    let busySlots = [];
    try {
      const response = await fetch(SCRIPT_URL, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8",
        },
        body: JSON.stringify({
          tipo_formulario: "Obtener Disponibilidad",
          fecha: selectedDate,
          correo_crew: CREW_EMAIL,
        }),
      });
      const resData = await response.json();
      if (resData && resData.status === "success" && Array.isArray(resData.busySlots)) {
        busySlots = resData.busySlots;
      }
    } catch (err) {
      console.warn("No se pudo conectar al calendario en Google Apps Script, utilizando fallback de retrocompatibilidad:", err);
    }

    // Calcular día de la semana
    const [year, month, day] = selectedDate.split("-").map(Number);
    // Usar el mediodía (12:00:00) para evitar problemas de desfase de zona horaria al obtener el día de la semana
    const dateObj = new Date(year, month - 1, day, 12, 0, 0);
    const dayOfWeek = dateObj.getDay(); // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado

    let candidateHours: string[] = [];
    if (dayOfWeek >= 1 && dayOfWeek <= 5) {
      // Lunes a Viernes: 4:00 PM a 6:30 PM (el último slot de 30 mins empieza a las 6:00 PM)
      candidateHours = ["16:00", "16:30", "17:00", "17:30", "18:00"];
    } else if (dayOfWeek === 6) {
      // Sábado: 10:00 AM a 1:00 PM (el último slot de 30 mins empieza a las 12:30 PM)
      candidateHours = ["10:00", "10:30", "11:00", "11:30", "12:00", "12:30"];
    }

    const availableSlots: string[] = [];
    const now = new Date();

    for (const timeStr of candidateHours) {
      const [hours, minutes] = timeStr.split(":").map(Number);
      const slotStart = new Date(year, month - 1, day, hours, minutes);
      const slotEnd = new Date(slotStart.getTime() + 30 * 60 * 1000);

      // 1. Filtrar si está en el pasado (si es hoy)
      if (slotStart.getTime() <= now.getTime()) {
        continue;
      }

      // 2. Filtrar si se traslapa con alguna hora ocupada de Google Calendar
      const hasOverlap = busySlots.some((event: { start: string; end: string }) => {
        const eventStart = new Date(event.start);
        const eventEnd = new Date(event.end);
        return slotStart < eventEnd && slotEnd > eventStart;
      });

      if (!hasOverlap) {
        availableSlots.push(timeStr);
      }
    }

    // Limpiar selector y rellenar opciones
    scheduleTimeSelect.innerHTML = "";

    if (dayOfWeek === 0) {
      const option = document.createElement("option");
      option.value = "";
      option.disabled = true;
      option.selected = true;
      option.textContent = "Los domingos no se labora";
      scheduleTimeSelect.appendChild(option);
    } else if (availableSlots.length === 0) {
      const option = document.createElement("option");
      option.value = "";
      option.disabled = true;
      option.selected = true;
      option.textContent = "No hay horarios disponibles";
      scheduleTimeSelect.appendChild(option);
    } else {
      const placeholderOpt = document.createElement("option");
      placeholderOpt.value = "";
      placeholderOpt.disabled = true;
      placeholderOpt.selected = true;
      placeholderOpt.textContent = "Elige un horario";
      scheduleTimeSelect.appendChild(placeholderOpt);

      availableSlots.forEach((slot) => {
        const [h, m] = slot.split(":").map(Number);
        const ampm = h >= 12 ? "PM" : "AM";
        const displayHour = h % 12 === 0 ? 12 : h % 12;
        const displayMinute = m < 10 ? `0${m}` : m;
        const displayStr = `${displayHour}:${displayMinute} ${ampm}`;

        const option = document.createElement("option");
        option.value = slot;
        option.textContent = displayStr;
        scheduleTimeSelect.appendChild(option);
      });
    }
  }

  // Establecer fecha mínima como hoy y agregar listener para cambios de fecha
  if (scheduleDateInput) {
    const now = new Date();
    
    // Obtener la fecha local actual del cliente en formato YYYY-MM-DD
    const localYear = now.getFullYear();
    const localMonth = String(now.getMonth() + 1).padStart(2, "0");
    const localDate = String(now.getDate()).padStart(2, "0");
    const todayStr = `${localYear}-${localMonth}-${localDate}`;
    
    scheduleDateInput.min = todayStr;
    
    // Determinar la fecha por defecto inicial para mejorar la UX
    let defaultDate = new Date(now);
    const dayOfWeek = defaultDate.getDay(); // 0 = Domingo, 6 = Sábado
    const currentHour = defaultDate.getHours();
    const currentMinute = defaultDate.getMinutes();
    const currentMinutes = currentHour * 60 + currentMinute;
    
    let daysToAdd = 0;
    if (dayOfWeek === 0) {
      // Domingo: la oficina está cerrada, seleccionar el próximo lunes
      daysToAdd = 1;
    } else if (dayOfWeek === 6 && currentMinutes >= 13 * 60) {
      // Sábado después de la 1:00 PM: oficina cerrada, seleccionar el próximo lunes
      daysToAdd = 2;
    } else if (dayOfWeek >= 1 && dayOfWeek <= 5 && currentMinutes >= 18.5 * 60) {
      // Lunes a Viernes después de las 6:30 PM: oficina cerrada, seleccionar el día siguiente
      if (dayOfWeek === 5) {
        // Viernes en la noche -> seleccionar sábado
        daysToAdd = 1;
      } else {
        // Lunes-Jueves en la noche -> seleccionar mañana
        daysToAdd = 1;
      }
    }
    
    if (daysToAdd > 0) {
      defaultDate.setDate(defaultDate.getDate() + daysToAdd);
    }
    
    const defYear = defaultDate.getFullYear();
    const defMonth = String(defaultDate.getMonth() + 1).padStart(2, "0");
    const defDate = String(defaultDate.getDate()).padStart(2, "0");
    const defaultDateStr = `${defYear}-${defMonth}-${defDate}`;
    
    scheduleDateInput.value = defaultDateStr;
    scheduleDateInput.addEventListener("change", updateAvailableHours);
    updateAvailableHours(); // Cargar disponibilidad inicial
  }

  if (scheduleBtn && scheduleModal) {
    scheduleBtn.addEventListener("click", (e) => {
      e.preventDefault();
      scheduleModal.classList.add("active");
      if (scheduleHeader) scheduleHeader.classList.remove("hidden");
      if (scheduleForm) scheduleForm.classList.remove("hidden");
      if (scheduleLoadingCard) scheduleLoadingCard.classList.add("hidden");
      if (scheduleSuccessCard) scheduleSuccessCard.classList.add("hidden");
      if (scheduleStatusEl) scheduleStatusEl.textContent = "";
      updateAvailableHours(); // Refrescar slots al abrir modal
    });
  }

  if (closeScheduleBtn && scheduleModal) {
    closeScheduleBtn.addEventListener("click", () => {
      scheduleModal.classList.remove("active");
    });
  }

  if (scheduleModal) {
    scheduleModal.addEventListener("click", (e) => {
      if (e.target === scheduleModal) scheduleModal.classList.remove("active");
    });
  }

  // ---------------------------
  // Google Sheets / Envío de Formularios
  // ---------------------------
  const CREW_EMAIL = "techcrewcr@gmail.com";
  const SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbzq81F12upMJSBo01TFg5Xoal6vilgKObmDF8fLig_MptDY2qJz1mCmFKRqaikFA8Sruw/exec";

  // Envío de Formulario de Contacto
  if (contactForm) {
    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (contactStatusEl) contactStatusEl.textContent = "Enviando...";

      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData.entries()) as Record<
        string,
        string
      >;

      try {
        await fetch(SCRIPT_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8",
          },
          body: JSON.stringify({
            ...data,
            tipo_formulario: "Contacto",
            correo_crew: CREW_EMAIL,
          }),
        });

        if (contactStatusEl)
          contactStatusEl.textContent =
            "¡Mensaje enviado! Pronto te contactaremos";
        contactForm.reset();

        setTimeout(() => {
          if (contactModal) contactModal.classList.remove("active");
          if (contactStatusEl) contactStatusEl.textContent = "";
        }, 1500);
      } catch (err) {
        console.error(err);
        if (contactStatusEl)
          contactStatusEl.textContent = "Error al enviar. Intenta de nuevo.";
      }
    });
  }

  // Envío de Formulario de Agendar Llamada
  if (scheduleForm) {
    scheduleForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(scheduleForm);
      const data = Object.fromEntries(formData.entries()) as Record<
        string,
        string
      >;

      const clientEmail = (data.email || "").trim();

      // Ocultar cabecera y formulario, y mostrar el estado de carga / progreso
      if (scheduleHeader) scheduleHeader.classList.add("hidden");
      if (scheduleForm) scheduleForm.classList.add("hidden");
      if (scheduleSuccessCard) scheduleSuccessCard.classList.add("hidden");
      if (scheduleLoadingCard) scheduleLoadingCard.classList.remove("hidden");
      if (scheduleLoadingDetails) {
        scheduleLoadingDetails.innerHTML = `Sincronizando evento en Google Calendar con <strong>${clientEmail}</strong> y <strong>${CREW_EMAIL}</strong>...`;
      }
      if (scheduleStatusEl) scheduleStatusEl.textContent = "";

      try {
        const startTime = Date.now();

        // Calcular fecha y hora de la cita
        const [year, month, day] = (data.fecha || "").split("-").map(Number);
        const [hours, minutes] = (data.hora || "").split(":").map(Number);
        const startDateTime = new Date(year, month - 1, day, hours, minutes);
        const endDateTime = new Date(startDateTime.getTime() + 30 * 60 * 1000);

        // Enviar datos y correos al backend de Google Apps Script con techcrewcr@gmail.com como destinatario y organizador
        await fetch(SCRIPT_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8",
          },
          body: JSON.stringify({
            ...data,
            tipo_formulario: "Agendar Llamada",
            correo_crew: CREW_EMAIL,
            correo_destino: CREW_EMAIL,
            destinatario: CREW_EMAIL,
            organizador: CREW_EMAIL,
            cliente_email: clientEmail,
            invitados: `${clientEmail}, ${CREW_EMAIL}`,
            attendees: [CREW_EMAIL, clientEmail],
            evento_titulo: `Llamada de Consultoría - Tech Crew (${data.servicio_interes})`,
            evento_descripcion: `Llamada de Consultoría Estratégica con Tech Crew.\n\n• Cliente: ${data.nombre}\n• Correo Cliente: ${clientEmail}\n• WhatsApp: ${data.telefono}\n• Servicio de Interés: ${data.servicio_interes}\n• Organizador: ${CREW_EMAIL}`,
            fecha: data.fecha,
            hora: data.hora,
            fecha_inicio_iso: startDateTime.toISOString(),
            fecha_fin_iso: endDateTime.toISOString(),
            send_invites: true,
            notificar: true,
          }),
        }).catch((err) => console.warn("Registro en Apps Script:", err));

        // Garantizar que la animación de progreso se aprecie con naturalidad (mínimo 1.5s)
        const elapsed = Date.now() - startTime;
        if (elapsed < 1500) {
          await new Promise((resolve) => setTimeout(resolve, 1500 - elapsed));
        }

        // Generar enlace de confirmación por WhatsApp con mensaje estructurado
        const waText = encodeURIComponent(
          `¡Hola Tech Crew! 👋 Acabo de agendar una llamada de consultoría para el día ${data.fecha} a las ${data.hora}.\n\n• Nombre: ${data.nombre}\n• Correo: ${clientEmail}\n• Solución: ${data.servicio_interes}\n• Evento: Agendado en Google Calendar con ${CREW_EMAIL}`,
        );
        if (waConfirmBtn) waConfirmBtn.href = `https://wa.me/?text=${waText}`;

        // Formatear fecha legible para el usuario
        const opcionesFecha: Intl.DateTimeFormatOptions = {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        };
        const fechaLegible = startDateTime.toLocaleDateString(
          "es-ES",
          opcionesFecha,
        );
        const horaLegible = startDateTime.toLocaleTimeString("es-ES", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: true,
        });

        if (scheduleSuccessDetails) {
          scheduleSuccessDetails.innerHTML = `
            <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(241, 205, 0, 0.25); border-radius: 12px; padding: 1.5rem; text-align: center; box-shadow: 0 4px 20px rgba(241, 205, 0, 0.08); margin-bottom: 0.5rem;">
              <div style="color: #f1cd00; font-weight: 800; font-size: 1.2rem; margin-bottom: 0.5rem; letter-spacing: 0.5px;">
                📅 ${fechaLegible}
              </div>
              <div style="color: #ffffff; font-weight: 700; font-size: 1.1rem; margin-bottom: 1rem;">
                🕒 ${horaLegible}
              </div>
              <div style="font-size: 0.88rem; color: #d0d0d0; line-height: 1.6; margin-bottom: 1.2rem; text-align: left;">
                Hemos sincronizado la invitación en Google Calendar entre <strong style="color: #fff;">${clientEmail}</strong> y <strong style="color: #fff;">${CREW_EMAIL}</strong>.
              </div>
              <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1rem; font-size: 0.82rem; color: #aaa; text-align: left; line-height: 1.4;">
                ✉️ Por favor, revisa tu bandeja de entrada y **acepta la invitación** para confirmar la cita y agregarla a tu agenda personal.
              </div>
            </div>
          `;
        }

        // Ocultar tarjeta de carga y mostrar exclusivamente la tarjeta de éxito con botón verd
        if (scheduleLoadingCard) scheduleLoadingCard.classList.add("hidden");
        if (scheduleSuccessCard) scheduleSuccessCard.classList.remove("hidden");
        scheduleForm.reset();
      } catch (err) {
        console.error(err);
        if (scheduleLoadingCard) scheduleLoadingCard.classList.add("hidden");
        if (scheduleForm) scheduleForm.classList.remove("hidden");
        if (scheduleHeader) scheduleHeader.classList.remove("hidden");
        if (scheduleStatusEl)
          scheduleStatusEl.textContent =
            "Ocurrió un error al procesar la cita. Intenta nuevamente.";
      }
    });
  }
</script>
